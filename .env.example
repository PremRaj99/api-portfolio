# Serverless Backend Environment Variables

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://premraj:your_password@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

# Gmail SMTP Email Dispatch (App Password)
# Note: Generate an App Password in your Google Account under Security > 2-Step Verification > App passwords
GMAIL_USER=web.premraj@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Admin OAuth & Session Security
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
JWT_SECRET=super_secret_jwt_key_prem_raj_portfolio_2026
ADMIN_EMAILS=web.premraj@gmail.com

# Server & CORS Config
PORT=5000
CLIENT_URL=http://localhost:3000
